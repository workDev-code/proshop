# Backend environment variables
# Copy to `.env` for local development
# On Render: set via dashboard or render.yaml sync: false

NODE_ENV=development
PORT=5000

# MongoDB — local or Atlas
MONGO_URI=mongodb://127.0.0.1:27017/proshop

# Auth — IMPORTANT: generate a strong random secret for production
# openssl rand -hex 32
JWT_SECRET=abc123

# PayPal sandbox (sign up at https://developer.paypal.com/)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_APP_SECRET=your_paypal_secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com

PAGINATION_LIMIT=8

{
  "name": "proshop2",
  "version": "2.0.0",
  "type": "module",
  "description": "Ecommerce application built with the MERN stack",
  "main": "server.js",
  "scripts": {
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "npm run dev --prefix mui-redesign",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "data:import": "node backend/seeder",
    "data:destroy": "node backend/seeder -d",
    "build": "npm install --prefix mui-redesign && npm run build --prefix mui-redesign",
    "generate-toc": "markdown-toc -i readme.md",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "seed": "node scripts/seed.js",
    "seed:fresh": "node scripts/seed.js --fresh",
    "screenshots": "node scripts/screenshots.cjs",
    "screenshots:fast": "node scripts/screenshots.cjs --no-build"
  },
  "author": "Brad Traversy",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "colors": "^1.4.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "concurrently": "^10.0.6",
    "jest": "^30.5.2",
    "markdown-toc": "^1.2.0",
    "nodemon": "^3.1.14",
    "playwright": "^1.49.0",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1"
  }
}

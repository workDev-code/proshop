# Frontend environment variables (only vars prefixed with REACT_APP_ are exposed)
# Copy to `.env` for local development
# On Vercel: set in Project Settings → Environment Variables

# Backend API URL — leave blank for Vercel rewrites/proxy, set explicitly in production
# Local example: http://localhost:5000
# Production example: https://proshop-api.onrender.com
REACT_APP_API_URL=
